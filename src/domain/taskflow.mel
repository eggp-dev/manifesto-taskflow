domain TaskFlow {
  type TaskStatus = "todo" | "in-progress" | "review" | "done"
  type TaskPriority = "low" | "medium" | "high"
  type ViewMode = "kanban" | "todo" | "table" | "trash"

  type Task = {
    id: string,
    title: string,
    description: string | null,
    status: TaskStatus,
    priority: TaskPriority,
    assignee: string | null,
    dueDate: string | null,
    tags: Array<string>,
    createdAt: string,
    updatedAt: string,
    deletedAt: string | null
  }

  state {
    tasks: Array<Task> = []
    selectedTaskId: string | null = null
    viewMode: ViewMode = "kanban"
    assistantOpen: boolean = false
  }

  computed activeTasks = filter(tasks, isNull($item.deletedAt))
  computed deletedTasks = filter(tasks, isNotNull($item.deletedAt))
  computed todoTasks = filter(activeTasks, eq($item.status, "todo"))
  computed inProgressTasks = filter(activeTasks, eq($item.status, "in-progress"))
  computed reviewTasks = filter(activeTasks, eq($item.status, "review"))
  computed doneTasks = filter(activeTasks, eq($item.status, "done"))
  computed selectedTask = findById(tasks, selectedTaskId)
  computed totalCount = len(activeTasks)
  computed todoCount = len(todoTasks)
  computed inProgressCount = len(inProgressTasks)
  computed reviewCount = len(reviewTasks)
  computed doneCount = len(doneTasks)
  computed deletedCount = len(deletedTasks)

  action createTask(task: Task) {
    onceIntent {
      patch tasks = append(tasks, task)
    }
  }

  action updateTask(id: string, title: string | null, description: string | null,
                    status: TaskStatus | null, priority: TaskPriority | null,
                    assignee: string | null, dueDate: string | null,
                    tags: Array<string> | null, updatedAt: string)
    dispatchable when existsById(tasks, id) {
    onceIntent {
      patch tasks = updateById(tasks, id, {
        title: coalesce(title, findById(tasks, id).title),
        description: coalesce(description, findById(tasks, id).description),
        status: coalesce(status, findById(tasks, id).status),
        priority: coalesce(priority, findById(tasks, id).priority),
        assignee: coalesce(assignee, findById(tasks, id).assignee),
        dueDate: coalesce(dueDate, findById(tasks, id).dueDate),
        tags: coalesce(tags, findById(tasks, id).tags),
        updatedAt: updatedAt
      })
    }
  }

  action moveTask(taskId: string, newStatus: TaskStatus)
    dispatchable when existsById(tasks, taskId) {
    onceIntent {
      patch tasks = updateById(tasks, taskId, {
        status: newStatus
      })
    }
  }

  action softDeleteTask(id: string, timestamp: string)
    dispatchable when existsById(tasks, id) {
    onceIntent {
      patch tasks = updateById(tasks, id, {
        deletedAt: timestamp,
        updatedAt: timestamp
      })
    }
  }

  action restoreTask(id: string)
    dispatchable when existsById(tasks, id) {
    onceIntent {
      patch tasks = updateById(tasks, id, {
        deletedAt: null
      })
    }
  }

  action permanentlyDeleteTask(id: string)
    dispatchable when existsById(tasks, id) {
    onceIntent {
      patch tasks = removeById(tasks, id)
    }
  }

  action emptyTrash()
    available when gt(deletedCount, 0) {
    onceIntent {
      patch tasks = filter(tasks, isNull($item.deletedAt))
    }
  }

  action selectTask(taskId: string | null)
    dispatchable when or(isNull(taskId), existsById(tasks, taskId)) {
    onceIntent {
      patch selectedTaskId = taskId
    }
  }

  action changeView(mode: ViewMode) {
    onceIntent {
      patch viewMode = mode
    }
  }

  action toggleAssistant(open: boolean) {
    onceIntent {
      patch assistantOpen = open
    }
  }
}
